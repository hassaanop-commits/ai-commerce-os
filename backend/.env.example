APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_commerce_os

SESSION_COOKIE_NAME=session_token
SESSION_IDLE_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
# true in production (HTTPS only); set false only for local http:// development
COOKIE_SECURE=true

# AI providers are resolved by name through app/ai/providers -- which
# provider actually runs a given call is chosen by AI_DEFAULT_PROVIDER /
# AI_IMAGE_PROVIDER below, while the model string for each task is chosen
# separately (and per-provider) in app/agents/runner.py. Only the API key
# for whichever provider you've selected needs to be set; an unset key
# simply makes that provider raise a clean "not configured" error instead of
# being usable -- everything else (routing, retry, cost tracking) still
# works, which is exactly what the test suite relies on.

# Which provider handles text generation (analysis, descriptions, titles,
# tags): "anthropic", "gemini", or "mock". Image generation is selected
# separately via AI_IMAGE_PROVIDER (not shown here -- see app/core/config.py).
AI_DEFAULT_PROVIDER=anthropic

# Only the key for your selected AI_DEFAULT_PROVIDER actually needs a value.
# Never commit a real key here or anywhere in the repository.
# ANTHROPIC_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here

# Bounded exponential backoff for transient AI provider failures (timeouts,
# rate limits) -- see app/ai/tools/_common.py. AI_MAX_RETRIES is additional
# attempts beyond the first; these defaults are sensible for local dev.
AI_MAX_RETRIES=3
AI_RETRY_INITIAL_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=8.0

# Optional per-organization monthly AI spend ceiling, in USD, summed from
# existing AIRun.cost_usd rows for the current calendar month (UTC). Unset
# (the default) means no limit is enforced. Uncomment and set a value to
# cap real provider cost exposure once an org is generating without limit.
# AI_ORG_MONTHLY_SPEND_LIMIT_USD=50.00

# In-memory sliding-window throttle for auth endpoints (login, signup,
# password-reset-request) -- see app/core/rate_limit.py. Single-instance
# only: state resets on restart and doesn't coordinate across workers.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60.0
