# Reinstalled fresh in the deps stage -- never copied from the host.
node_modules/

# Build output -- regenerated by `npm run build` inside the image.
.next/
out/

# Secrets -- never baked into an image; real deployments inject these as
# environment variables instead.
.env.local
.env.*.local
!.env.local.example

# Tests and dev-only tooling -- not needed to run the app.
**/*.test.ts
**/*.test.tsx
vitest.config.ts
vitest.setup.ts
coverage/

# TypeScript build cache -- host-local, meaningless inside the image.
tsconfig.tsbuildinfo
*.tsbuildinfo

# VCS / editor / OS cruft.
.git/
.gitignore
.vscode/
.idea/
.DS_Store

# Docs, not needed at runtime.
README.md
*.md
